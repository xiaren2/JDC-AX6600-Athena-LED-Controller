{
	"luci-app-athena-led": {
		"description": "Grant ACL to LuCI app 'Athena LED Screen Controller' for screen status polling + UCI writes + service control.",
		"read": {
			"cgi-io": [ "exec" ],
			"file": {
				"/etc/athena_led/anim":  [ "list" ],
				"/var/run/athena-led.pid": [ "read" ],
				"/proc/net/dev":         [ "read" ]
			},
			"ubus": {
				"file":   [ "read", "list", "stat" ],
				"system": [ "info", "board" ]
			},
			"uci": [ "athena_led" ],
			"process": {
				"/proc/*/cmdline": [ "read" ]
			}
		},
		"write": {
			"cgi-io": [ "exec" ],
			"file": {
				"/etc/config/athena_led": [ "write" ]
			},
			"ubus": {
				"file": [ "write", "remove", "exec" ]
			},
			"uci": [ "athena_led" ],
			"service": {
				"athena_led": [ "start", "stop", "restart", "reload", "enable", "disable" ]
			}
		}
	}
}
