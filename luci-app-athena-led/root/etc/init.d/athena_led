#!/bin/sh /etc/rc.common

START=99
STOP=99
USE_PROCD=1
PROG=/usr/bin/athena-led

check_binary() {
    [ -x "$PROG" ] || return 1
}

start_service() {
    config_load 'athena_led'
    local cfg='general' 

    local enabled
    config_get_bool enabled "$cfg" 'enabled' '0'
    [ "$enabled" -eq 0 ] && return 1

    check_binary || return 1

    # --- 1. 读取所有配置 (基础 + 定时 + 按键 + LED + GPIO/缓存) ---
    local seconds lightLevel option netInterface ipUrl value url \
          weatherCity weatherSource seniverseKey tempFlag \
          enableSleep sleepStart sleepEnd \
          buttonGpio enableMeshButton meshButtonGpio meshShortAction meshLongAction \
          disableLedClock disableLedMedal disableLedUp disableLedDown \
          httpCacheSecs gpioBackend gpioBase

    # 基础配置
    config_get seconds "$cfg" 'duration' '5'
    config_get lightLevel "$cfg" 'light_level' '5'
    config_get option "$cfg" 'display_order' 'date'
    config_get netInterface "$cfg" 'net_interface' 'br-lan'
    config_get ipUrl "$cfg" 'wan_ip_custom_url' 'http://checkip.amazonaws.com'
    config_get value "$cfg" 'custom_content' 'AX6600'
    config_get url "$cfg" 'http_url' ''
    config_get httpLength "$cfg" 'http_length' '15'
    config_get weatherCity "$cfg" 'weather_city' 'Shenzhen'
    config_get weatherSource "$cfg" 'weather_source' 'wttr'
    config_get weatherFormat "$cfg" 'weather_format' 'simple'
    config_get seniverseKey "$cfg" 'seniverse_key' ''
    config_get tempFlag "$cfg" 'temp_sensors' '0 1 2 3 4'

    # 定时配置
    config_get_bool enableSleep "$cfg" 'enable_sleep' '0'
    config_get sleepStart "$cfg" 'off_time' ''
    config_get sleepEnd "$cfg" 'on_time' ''

    # 按键配置
    config_get buttonGpio "$cfg" 'button_gpio' '71'
    config_get_bool enableMeshButton "$cfg" 'enable_mesh_button' '0'
    config_get meshButtonGpio "$cfg" 'mesh_button_gpio' '72'
    config_get meshShortAction "$cfg" 'mesh_short_action' 'none'
    config_get meshLongAction "$cfg" 'mesh_long_action' 'none'

    # 4 盏状态 LED 独立禁用开关
    config_get_bool disableLedClock "$cfg" 'disable_led_clock' '0'
    config_get_bool disableLedMedal "$cfg" 'disable_led_medal' '0'
    config_get_bool disableLedUp "$cfg" 'disable_led_up' '0'
    config_get_bool disableLedDown "$cfg" 'disable_led_down' '0'

    # ★ 网络请求缓存间隔 (秒) - 默认 300s=5min, NetAgent 后台按这个频率刷新
    #   太长会数据旧, 太短会被 API 拉黑; 建议 60~1800
    config_get httpCacheSecs "$cfg" 'http_cache_secs' '300'

    # ★ GPIO 后端: auto(优先字符设备, 失败回退 sysfs) / cdev / sysfs
    config_get gpioBackend "$cfg" 'gpio_backend' 'auto'

    # ★ GPIO 基址: auto 自动探测, 也可填 512 (内核6.x) / 432 (内核5.4) / 0
    #   只有 sysfs 后端用; cdev 后端直接用字符设备不需要 base
    config_get gpioBase "$cfg" 'gpio_base' 'auto'

    # 逻辑处理：如果不启用休眠，强制传空字符串，Rust 端收到空字符串则不执行休眠逻辑
    if [ "$enableSleep" -eq 0 ]; then
        sleepStart=""
        sleepEnd=""
    fi

    # --- 2. 启动实例 (必须包含所有参数) ---
    procd_open_instance
    procd_set_param command "$PROG"
    
    # 基础参数
    procd_append_param command --seconds "$seconds"
    procd_append_param command --light-level "$lightLevel"
    procd_append_param command --display-order "$option"
    procd_append_param command --net-interface "$netInterface"
    procd_append_param command --ip-url "$ipUrl"
    procd_append_param command --custom-text "$value"
    procd_append_param command --custom-http-url "$url"
    procd_append_param command --http-length "$httpLength"
    procd_append_param command --weather-city "$weatherCity"
    procd_append_param command --weather-source "$weatherSource"
    procd_append_param command --seniverse-key "$seniverseKey"
    procd_append_param command --weather-format "$weatherFormat"
    procd_append_param command --temp-flag "$tempFlag"

    # ★ 缓存间隔 + GPIO 后端 + GPIO base (核心新参数)
    procd_append_param command --http-cache-secs "$httpCacheSecs"
    procd_append_param command --gpio-backend "$gpioBackend"
    procd_append_param command --gpio-base "$gpioBase"
    
    # 定时参数 (必须在 close_instance 之前添加！)
    procd_append_param command --sleep-start "$sleepStart"
    procd_append_param command --sleep-end "$sleepEnd"

    # 按键参数
    procd_append_param command --button-gpio "$buttonGpio"
    procd_append_param command --enable-mesh-button "$enableMeshButton"
    procd_append_param command --mesh-button-gpio "$meshButtonGpio"
    procd_append_param command --mesh-short-action "$meshShortAction"
    procd_append_param command --mesh-long-action "$meshLongAction"

    # 4 盏状态 LED 独立禁用参数 (flag 形式: 存在即生效)
    if [ "$disableLedClock" -eq 1 ]; then
        procd_append_param command --disable-led-clock
    fi
    if [ "$disableLedMedal" -eq 1 ]; then
        procd_append_param command --disable-led-medal
    fi
    if [ "$disableLedUp" -eq 1 ]; then
        procd_append_param command --disable-led-up
    fi
    if [ "$disableLedDown" -eq 1 ]; then
        procd_append_param command --disable-led-down
    fi

    # 守护进程配置
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    
    # --- 3. 结束配置 ---
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "athena_led"
}
